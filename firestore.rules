rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserGroup() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId;
    }

    function inMyGroup(data) {
      return request.auth != null && data.groupId == getUserGroup();
    }

    match /items/{itemId} {
      // Un article non privé appartient au foyer : les deux comptes le voient et
      // le modifient (couleurs, liens, tableaux, ordre). Seul un article privé
      // reste réservé à son créateur.
      // `get(..., défaut)` protège les articles créés avant l'ajout de ces
      // champs : sans lui, un article sans `userId` devenait immodifiable pour
      // tout le monde, ce qui se manifestait par une erreur « impossible de
      // mettre à jour » au moment d'enregistrer.
      function visible(data) {
        return inMyGroup(data) &&
               (!data.get('isPrivate', false) || data.get('userId', '') == request.auth.uid);
      }

      allow read: if visible(resource.data);

      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.groupId == getUserGroup();

      // La propriété et le groupe ne peuvent pas être réécrits au passage.
      allow update: if visible(resource.data) &&
                    request.resource.data.groupId == resource.data.groupId &&
                    request.resource.data.get('userId', '') == resource.data.get('userId', '');

      allow delete: if visible(resource.data);
    }

    match /boards/{boardId} {
      function visible(data) {
        return inMyGroup(data) &&
               (!data.get('isPrivate', false) || data.get('ownerId', '') == request.auth.uid);
      }

      allow read: if visible(resource.data);

      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.groupId == getUserGroup();

      allow update: if visible(resource.data) &&
                    request.resource.data.groupId == resource.data.groupId &&
                    request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '');

      allow delete: if visible(resource.data);
    }

    match /users/{userId} {
      // Les profils ne contiennent qu'un e-mail et un groupe ; la lecture reste
      // ouverte aux comptes authentifiés, l'écriture au seul propriétaire.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /immo_searches/{searchId} {
      allow read: if inMyGroup(resource.data);
      allow create: if request.auth != null &&
                    request.resource.data.groupId == getUserGroup();
      allow update, delete: if inMyGroup(resource.data);
    }
  }
}
